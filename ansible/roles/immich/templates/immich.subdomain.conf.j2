## Immich photo library configuration
# Custom config - no LinuxServer pre-built config available
# Includes WebSocket support for /api/socket.io real-time updates
# client_max_body_size 0: unbounded uploads (library import, originals)

server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name immich.{{ internal_domain }};

    include /config/nginx/ssl.conf;

    client_max_body_size 0;

    location / {
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        set $upstream_app {{ immich_proxy_ip }};
        set $upstream_port {{ immich_port }};
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;
    }

    location /api/socket.io {
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        set $upstream_app {{ immich_proxy_ip }};
        set $upstream_port {{ immich_port }};
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;

    }
}
