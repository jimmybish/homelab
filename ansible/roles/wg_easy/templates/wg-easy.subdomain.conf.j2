## Version 2024/07/16
# wg-easy web UI subdomain reverse proxy config

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name wg.{{ internal_domain }};

    include /config/nginx/ssl.conf;

    client_max_body_size 0;

    location / {
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        set $upstream_app {{ wg_easy_proxy_ip }};
        set $upstream_port {{ wg_easy_web_port }};
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;

        # WebSocket support (wg-easy uses WS for live client updates)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
