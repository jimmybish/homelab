#!/usr/bin/env bash
# {{ ansible_managed }}
# Launcher for the pinned GitHub MCP server used by the Hermes gateway.
#
# The gateway launches this instead of the binary directly so the GitHub
# App auth environment lives in exactly one managed file. The pinned
# github-mcp-server ({{ hermes_mcp_github_version }}) supports NATIVE GitHub
# App authentication in stdio mode: it signs short-lived JWTs with the App
# private key and mints and refreshes installation access tokens itself
# (upstream docs/github-app-auth.md at the pinned tag). This launcher
# therefore exports only the three auth variables the server reads:
# GITHUB_APP_ID, GITHUB_APP_INSTALLATION_ID, and
# GITHUB_APP_PRIVATE_KEY_PATH.
#
# The private key is a vault-managed PEM deployed to THIS host at
# {{ hermes_mcp_github_app_private_key_file }} with owner-only mode. Its
# contents never enter this script, any environment variable value, argv,
# or any log. No personal access token is exported: upstream treats a token
# and App auth as mutually exclusive, and the previous launcher-minted
# installation-token-as-PAT transport (with its ~1h staleness window and
# stdio recycle) is retired.
#
# The launcher is kept (instead of putting the env in the gateway config)
# so the key path appears in one 0750 managed file and the profile config
# keeps no credential-adjacent env block at all.
#
# After exporting the auth environment this script execs
# hermes-github-mcp-relay, which runs the pinned binary as a child and
# filters JSON-RPC frames in both directions. That relay is the technical
# capability boundary; the gateway config additionally restricts
# registration with --tools, --toolsets "", and the Hermes-side
# tools.include filter.
#
# All arguments given to this launcher are forwarded verbatim to the relay
# and then to the pinned binary, so the gateway configuration owns the MCP
# flags.
set -eu
set -o pipefail

export HOME="{{ hermes_user_home }}"
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

export GITHUB_APP_ID={{ hermes_virtuajimmy_github_app_id | string | to_json }}
export GITHUB_APP_INSTALLATION_ID={{ hermes_virtuajimmy_github_app_installation_id | string | to_json }}
export GITHUB_APP_PRIVATE_KEY_PATH={{ hermes_mcp_github_app_private_key_file | to_json }}

if [[ ! -r "$GITHUB_APP_PRIVATE_KEY_PATH" ]]; then
  echo "hermes-github-mcp-launch: App private key file is missing or unreadable" >&2
  exit 1
fi

exec {{ hermes_mcp_github_relay_file | quote }} "$@"
