## Hermes Agent gateway web UI (https://hermes-gateway.{{ internal_domain }})
# Custom config - no LinuxServer pre-built config available.
# Upstream: the Hermes gateway web UI on the hermes host (plain http; TLS
# terminates at SWAG per estate convention). The UI uses websockets for
# live updates.
#
# WEBSOCKETS: SWAG's shared /config/nginx/proxy.conf already provides
# proxy_http_version 1.1, Upgrade $http_upgrade + Connection via the
# $connection_upgrade map, and 3600s read/send/connect timeouts. The
# kanban_ui sibling vhost proved (PR#13) that re-declaring Upgrade/
# Connection here either fails nginx -t as a duplicate directive or
# doubles the header value / drops the other proxy.conf headers
# (proxy_set_header at the location level REPLACES the inherited set),
# so nothing is re-declared here. The only per-vhost websocket extra is
# proxy_buffering off, so streamed events are not held back.

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name hermes-gateway.{{ internal_domain }};

    include /config/nginx/ssl.conf;

    client_max_body_size 0;

    location / {
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        set $upstream_app {{ hermes_gateway_proxy_ip }};
        set $upstream_port {{ hermes_gateway_port }};
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;

        # Long-lived websocket / SSE streams must not be buffered.
        proxy_buffering off;
    }
}
