[Unit]
Description=Hermes Agent Web Dashboard
After=network.target

[Service]
Type=simple
User={{ hermes_user }}
WorkingDirectory={{ hermes_user_home }}
EnvironmentFile={{ hermes_env_file }}
ExecStart={{ hermes_bin }} dashboard --host {{ hermes_bind_address }} --port {{ hermes_port }} --no-open
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target