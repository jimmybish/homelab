# Per-profile secrets for this Hermes profile.
# API keys and tokens set here override the shell environment.
# Behavioral settings belong in config.yaml, not here.
COPILOT_GITHUB_TOKEN={{ hermes_copilot_github_token | trim }}
TERMINAL_ENV=ssh
TERMINAL_SSH_HOST={{ hermes_copilot_ssh_host }}
TERMINAL_SSH_USER={{ hermes_copilot_ssh_user }}
TERMINAL_SSH_KEY={{ hermes_copilot_ssh_private_key_file }}
