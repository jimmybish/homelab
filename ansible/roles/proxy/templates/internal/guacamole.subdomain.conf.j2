## Apache Guacamole (internal)
# make sure that your dns has a cname set for guacamole
# Guacamole webapp is served at /guacamole/ inside the container; we transparently
# rewrite the client-facing / to that path.

server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name guacamole.{{ internal_domain }};

    include /config/nginx/ssl.conf;

    client_max_body_size 0;

    location / {
        return 301 $scheme://$host/guacamole/;
    }

    location /guacamole/ {
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        set $upstream_app {{ guacamole_proxy_ip }};
        set $upstream_port {{ guacamole_web_port }};
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;

        # WebSocket tunnel for interactive sessions
        proxy_buffering off;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $http_connection;
        access_log off;
    }
}
