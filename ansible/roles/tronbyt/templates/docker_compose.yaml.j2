services:
  tronbyt:
    image: ghcr.io/tronbyt/server:{{ tronbyt_version }}
    container_name: tronbyt
    restart: unless-stopped
    init: true
    environment:
      - PUID={{ docker_user_puid }}
      - PGID={{ docker_user_pgid }}
      - TZ={{ timezone }}
      - PRODUCTION={{ tronbyt_production }}
      - ENABLE_USER_REGISTRATION={{ tronbyt_enable_user_registration }}
      - LOG_LEVEL={{ tronbyt_log_level }}
    ports:
      - '{{ tronbyt_port }}:{{ tronbyt_container_port }}'
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - {{ tronbyt_folder }}:/app/data
    healthcheck:
      test: ["CMD", "/app/tronbyt-server", "health"]
      interval: 1m30s
      timeout: 10s
      retries: 3
      start_period: 10s
