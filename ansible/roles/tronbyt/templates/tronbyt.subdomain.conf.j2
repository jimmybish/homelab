## Version 2026/08/04 - Adapted for homelab
# make sure that your tronbyt container is named tronbyt
# make sure that your dns has a cname set for tronbyt

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name tronbyt.{{ internal_domain }};

    include /config/nginx/ssl.conf;

    client_max_body_size 0;

    location / {
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        set $upstream_app {{ tronbyt_proxy_ip }};
        set $upstream_port {{ tronbyt_port }};
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;
    }
}
