apiVersion: 1

groups:
  # Node Exporter Scrape Failing - fires when a non-cAdvisor scrape target is
  # unreachable. NOTE: this means Prometheus can't scrape that job/instance -
  # it does NOT by itself mean the host is down (a busy agent process can also
  # cause this). See "Sparky Unreachable (No Logs)" below for a true
  # host-down signal on Sparky specifically, and ansible/docs/known-issues.md
  # for the incident that prompted this split.
  - orgId: 1
    name: host_down
    folder: Infrastructure
    interval: 1m
    rules:
      - uid: host-down-1
        title: Node Exporter Scrape Failing
        condition: C
        for: 2m
        noDataState: "OK"
        execErrState: "OK"
        annotations:
          summary: "Metrics scrape failing for {% raw %}{{ $labels.job }}{% endraw %} on {% raw %}{{ $labels.instance }}{% endraw %}"
          description: "Prometheus has been unable to scrape {% raw %}{{ $labels.instance }}{% endraw %} (job: {% raw %}{{ $labels.job }}{% endraw %}) for more than 2 minutes. This can mean the host is unreachable, or that the exporter/agent process on that host is too busy to respond in time - check Loki log ingestion from the host to tell the two apart before assuming an outage."
        labels:
          severity: critical
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: {{ grafana_prometheus_uid }}
            model:
              refId: A
              expr: "up{job!=\"cadvisor\"} == bool 0"
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: __expr__
            model:
              refId: B
              type: reduce
              expression: A
              reducer: last
              intervalMs: 1000
              maxDataPoints: 43200
              settings:
                mode: ""
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: B
              intervalMs: 1000
              maxDataPoints: 43200
              conditions:
                - evaluator:
                    type: gt
                    params:
                      - 0.5

  # Sparky Unreachable (No Logs) - true host-down signal for Sparky, based on
  # Loki log ingestion rather than the node_exporter scrape above. Scoped to
  # Sparky only because it's the one host that has shown scrape flapping
  # under memory pressure while remaining fully reachable and logging
  # normally (see ansible/docs/known-issues.md).
  - orgId: 1
    name: sparky_unreachable
    folder: Infrastructure
    interval: 1m
    rules:
      - uid: sparky-unreachable-1
        title: Sparky Unreachable (No Logs)
        condition: C
        for: 2m
        noDataState: "OK"
        execErrState: "OK"
        annotations:
          summary: "No logs received from sparky in 5 minutes"
          description: "Sparky has sent no journal/docker log lines to Loki in the last 5 minutes. Unlike the node_exporter scrape check, this does not depend on the host's own metrics agent responding in time, so it is a stronger signal that the host itself is actually unreachable."
        labels:
          severity: critical
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: {{ grafana_loki_uid }}
            model:
              refId: A
              expr: "absent_over_time({host=\"sparky\"}[5m])"
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: __expr__
            model:
              refId: B
              type: reduce
              expression: A
              reducer: last
              intervalMs: 1000
              maxDataPoints: 43200
              settings:
                mode: ""
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: B
              intervalMs: 1000
              maxDataPoints: 43200
              conditions:
                - evaluator:
                    type: gt
                    params:
                      - 0.5

  # cAdvisor Down - fires when a configured cAdvisor target is unreachable
  - orgId: 1
    name: cadvisor_down
    folder: Infrastructure
    interval: 1m
    rules:
      - uid: cadvisor-down-1
        title: cAdvisor Down
        condition: C
        for: 2m
        noDataState: "OK"
        execErrState: "OK"
        annotations:
          summary: "cAdvisor is down on {% raw %}{{ $labels.instance }}{% endraw %}"
          description: "The cAdvisor target {% raw %}{{ $labels.instance }}{% endraw %} has been unreachable for more than 2 minutes."
        labels:
          severity: critical
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: {{ grafana_prometheus_uid }}
            model:
              refId: A
              expr: "up{job=\"cadvisor\"} == bool 0"
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: __expr__
            model:
              refId: B
              type: reduce
              expression: A
              reducer: last
              intervalMs: 1000
              maxDataPoints: 43200
              settings:
                mode: ""
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: B
              intervalMs: 1000
              maxDataPoints: 43200
              conditions:
                - evaluator:
                    type: gt
                    params:
                      - 0.5

  # Container Down - fires when a container stops reporting metrics
  - orgId: 1
    name: container_down
    folder: Infrastructure
    interval: 1m
    rules:
      - uid: container-down-1
        title: Container Down
        condition: C
        for: 2m
        noDataState: "OK"
        execErrState: "OK"
        annotations:
          summary: "Container {% raw %}{{ $labels.name }}{% endraw %} is not running on {% raw %}{{ $labels.instance }}{% endraw %}"
          description: "The Docker container {% raw %}{{ $labels.name }}{% endraw %} on {% raw %}{{ $labels.instance }}{% endraw %} has been down for more than 2 minutes."
        labels:
          severity: critical
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: {{ grafana_prometheus_uid }}
            model:
              refId: A
              expr: "time() - container_last_seen{name!=\"\"}"
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: __expr__
            model:
              refId: B
              type: reduce
              expression: A
              reducer: last
              intervalMs: 1000
              maxDataPoints: 43200
              settings:
                mode: ""
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: B
              intervalMs: 1000
              maxDataPoints: 43200
              conditions:
                - evaluator:
                    type: gt
                    params:
                      - 60

  # Disk Space Low (local) - fires when a local filesystem (zfs/ext4/xfs/btrfs/...) drops below threshold
  - orgId: 1
    name: disk_space_low_local
    folder: Infrastructure
    interval: 1m
    rules:
      - uid: disk-space-low-local-1
        title: Disk Space Low (Local)
        condition: C
        for: 5m
        noDataState: "OK"
        execErrState: "OK"
        annotations:
          summary: "Disk space low on {% raw %}{{ $labels.instance }}{% endraw %} ({% raw %}{{ $labels.mountpoint }}{% endraw %})"
          description: "Filesystem {% raw %}{{ $labels.mountpoint }}{% endraw %} on {% raw %}{{ $labels.instance }}{% endraw %} has less than {{ grafana_alert_disk_threshold_local }}% free space."
        labels:
          severity: warning
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: {{ grafana_prometheus_uid }}
            model:
              refId: A
              expr: "(node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs|nfs|nfs4|fuse.*|cifs|smbfs|autofs|devtmpfs|ramfs\",mountpoint!~\"/boot.*\"} / node_filesystem_size_bytes) * 100"
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: __expr__
            model:
              refId: B
              type: reduce
              expression: A
              reducer: last
              intervalMs: 1000
              maxDataPoints: 43200
              settings:
                mode: ""
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: B
              intervalMs: 1000
              maxDataPoints: 43200
              conditions:
                - evaluator:
                    type: lt
                    params:
                      - {{ grafana_alert_disk_threshold_local }}

  # Loki Error Patterns - fires when error log rate spikes
  - orgId: 1
    name: loki_error_patterns
    folder: Infrastructure
    interval: 1m
    rules:
      - uid: loki-errors-1
        title: High Error Rate in Logs
        condition: C
        for: 5m
        noDataState: "OK"
        execErrState: "OK"
        annotations:
          summary: "High error rate detected in logs for {% raw %}{{ $labels.host }}{% endraw %} / {% raw %}{{ $labels.container_name }}{% endraw %}"
          description: "More than {{ grafana_alert_loki_error_threshold }} error/fatal/panic log lines detected in 5 minutes from {% raw %}{{ $labels.host }}{% endraw %} ({% raw %}{{ $labels.container_name }}{% endraw %})."
        labels:
          severity: warning
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: {{ grafana_loki_uid }}
            model:
              refId: A
              # Parse logfmt and filter on level=error|fatal|panic instead of raw regex.
              # Also drop self-feedback / known-noise lines:
              #   - Loki internals (caller=scheduler_processor.go / retry.go / metrics.go / engine.go / ingester.go)
              #   - Grafana noisy loggers (ngalert.*, provisioning.*, infra.usagestats.*)
              #   - "context canceled" tails of the above
              # See `.github/agents/grafana_admin.agent.md` for the self-feedback caveat.
              expr: "sum by (host, container_name) (count_over_time({source=\"docker\"} != \"caller=scheduler_processor.go\" != \"caller=retry.go\" != \"caller=metrics.go\" != \"caller=engine.go\" != \"caller=ingester.go\" != \"App runner exited without error\" !~ \"logger=(ngalert|provisioning|infra\\\\.usagestats)\" | logfmt | level=~\"(?i)error|fatal|panic\" != \"context canceled\" [5m]))"
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: __expr__
            model:
              refId: B
              type: reduce
              expression: A
              reducer: last
              intervalMs: 1000
              maxDataPoints: 43200
              settings:
                mode: ""
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: B
              intervalMs: 1000
              maxDataPoints: 43200
              conditions:
                - evaluator:
                    type: gt
                    params:
                      - {{ grafana_alert_loki_error_threshold }}

  # N8N Discord Trigger Loop - fires when the Discord bot trigger nodes are cycling
  # through repeated disconnect/reconnect loops, indicating stale IPC state
  - orgId: 1
    name: n8n_discord_trigger_loop
    folder: Infrastructure
    interval: 1m
    rules:
      - uid: n8n-discord-trigger-loop-1
        title: N8N Discord Trigger Reconnect Loop
        condition: C
        for: 5m
        noDataState: "OK"
        execErrState: "OK"
        annotations:
          summary: "N8N Discord trigger nodes are in a reconnect loop on {% raw %}{{ $labels.host }}{% endraw %}"
          description: "More than {{ grafana_alert_n8n_trigger_loop_threshold }} 'removing trigger node' events detected in 5 minutes from the N8N container on {% raw %}{{ $labels.host }}{% endraw %}. This indicates the Discord bot IPC connection is cycling and workflows may not be firing."
        labels:
          severity: warning
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: {{ grafana_loki_uid }}
            model:
              refId: A
              expr: "sum by (host) (count_over_time({container_name=\"n8n\"} |= \"removing trigger node\" [5m]))"
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: __expr__
            model:
              refId: B
              type: reduce
              expression: A
              reducer: last
              intervalMs: 1000
              maxDataPoints: 43200
              settings:
                mode: ""
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: B
              intervalMs: 1000
              maxDataPoints: 43200
              conditions:
                - evaluator:
                    type: gt
                    params:
                      - {{ grafana_alert_n8n_trigger_loop_threshold }}

  # NVMe Drive Temperature - Proxmox Samsung 990 PRO drives.
  # Only the Composite sensor (hwmon temp1) is evaluated: Samsung's 0-70°C operating
  # spec is measured against it. Sensor 1/2 (temp2/temp3) read hotter and are dashboard-only.
  - orgId: 1
    name: proxmox_hardware
    folder: Infrastructure
    interval: 1m
    rules:
      - uid: nvme-temp-high-1
        title: NVMe Drive Temperature High
        condition: C
        for: {{ grafana_alert_nvme_temp_for }}
        noDataState: "OK"
        execErrState: "OK"
        annotations:
          summary: "NVMe composite temperature high on {% raw %}{{ $labels.instance }}{% endraw %}"
          description: "NVMe composite temperature is {% raw %}{{ printf \"%.1f\" $values.B.Value }}{% endraw %}°C, above {{ grafana_alert_nvme_temp_threshold }}°C for {{ grafana_alert_nvme_temp_for }} (Samsung 990 PRO operating spec: 0-70°C). Resolves once it drops below {{ grafana_alert_nvme_temp_recovery_threshold }}°C."
          runbook_url: "https://wiki.{{ internal_domain }}/storage#nvme-temperature-management"
        labels:
          severity: warning
          component: storage
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: {{ grafana_prometheus_uid }}
            model:
              refId: A
              # max() collapses to one value per instance, and the reduce step (B) is
              # required so the threshold (C) evaluates a single instant value rather
              # than a multi-point range frame.
              expr: "max by (instance) (node_hwmon_temp_celsius{chip=\"nvme_nvme0\",sensor=\"temp1\",instance=~\"proxmox-[12].*\"})"
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: __expr__
            model:
              refId: B
              type: reduce
              expression: A
              reducer: last
              intervalMs: 1000
              maxDataPoints: 43200
              settings:
                mode: ""
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: B
              intervalMs: 1000
              maxDataPoints: 43200
              conditions:
                - evaluator:
                    type: gt
                    params:
                      - {{ grafana_alert_nvme_temp_threshold }}
                  # Recovery threshold (hysteresis): once firing, stay firing until below this.
                  unloadEvaluator:
                    type: lt
                    params:
                      - {{ grafana_alert_nvme_temp_recovery_threshold }}

      - uid: nvme-temp-critical-1
        title: NVMe Drive Temperature Critical
        condition: C
        for: 2m
        noDataState: "OK"
        execErrState: "OK"
        annotations:
          summary: "NVMe composite temperature critical on {% raw %}{{ $labels.instance }}{% endraw %}"
          description: "NVMe composite temperature is {% raw %}{{ printf \"%.1f\" $values.B.Value }}{% endraw %}°C and has reached the drive's own warning temperature threshold (WCTEMP, ~82°C on the 990 PRO), or the drive is asserting its SMART temperature alarm. Expect thermal throttling; investigate cooling and I/O load immediately."
          runbook_url: "https://wiki.{{ internal_domain }}/storage#nvme-temperature-management"
        labels:
          severity: critical
          component: storage
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: {{ grafana_prometheus_uid }}
            model:
              refId: A
              # Returns the composite temperature only while it is at/above the drive-reported
              # warning threshold (hwmon temp1_max = WCTEMP) or the drive's temperature alarm
              # (SMART critical-warning temperature bit) is set; otherwise no data (OK).
              expr: >-
                max by (instance) (node_hwmon_temp_celsius{chip="nvme_nvme0",sensor="temp1",instance=~"proxmox-[12].*"})
                and on (instance)
                (
                  max by (instance) (node_hwmon_temp_celsius{chip="nvme_nvme0",sensor="temp1",instance=~"proxmox-[12].*"})
                    >= on (instance)
                  max by (instance) (node_hwmon_temp_max_celsius{chip="nvme_nvme0",sensor="temp1",instance=~"proxmox-[12].*"})
                  or on (instance)
                  max by (instance) (node_hwmon_temp_alarm{chip="nvme_nvme0",sensor="temp1",instance=~"proxmox-[12].*"}) == 1
                )
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: __expr__
            model:
              refId: B
              type: reduce
              expression: A
              reducer: last
              intervalMs: 1000
              maxDataPoints: 43200
              settings:
                mode: ""
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: B
              intervalMs: 1000
              maxDataPoints: 43200
              conditions:
                - evaluator:
                    type: gt
                    params:
                      - 0
